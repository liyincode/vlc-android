+
+int netbios_wait(struct netbios_abort_ctx *ctx, int fd, bool writing,
+                 struct timeval *timeout)
+{
+    if (fd < 0)
+    {
+        errno = EBADF;
+        return -1;
+    }
+#ifdef _WIN32
+    /* Winsock fd_set stores socket handles rather than indexing their values. */
+    fd_set read_fds, write_fds, error_fds;
+    FD_ZERO(&read_fds);
+    FD_ZERO(&write_fds);
+    FD_ZERO(&error_fds);
+    if (writing)
+        FD_SET(fd, &write_fds);
+    else
+        FD_SET(fd, &read_fds);
+    FD_SET(fd, &error_fds);
+    int res = select(fd + 1, &read_fds, &write_fds, &error_fds, timeout);
+    if (netbios_abort_ctx_is_aborted(ctx))
+    {
+        errno = EINTR;
+        return -1;
+    }
+    return res > 0 ? 1 : res;
+#else
+    struct pollfd fds[2] = {
+        { .fd = fd, .events = writing ? POLLOUT : POLLIN },
+        { .fd = -1, .events = POLLIN },
+    };
+#ifdef NS_ABORT_USE_PIPE
+    fds[1].fd = ctx->pipe[0];
+#else
+    if (netbios_abort_ctx_is_aborted(ctx))
+    {
+        errno = EINTR;
+        return -1;
+    }
+#endif
+    int milliseconds = -1;
+    int64_t remaining = 0;
+    struct timespec before;
+    if (timeout != NULL)
+    {
+        remaining = (int64_t)timeout->tv_sec * 1000000 + timeout->tv_usec;
+        int64_t rounded = (remaining + 999) / 1000;
+        milliseconds = rounded > INT_MAX ? INT_MAX : (int)rounded;
+        if (clock_gettime(CLOCK_MONOTONIC, &before) != 0)
+            return -1;
+    }
+    int res = poll(fds, 2, milliseconds);
+    int saved_errno = errno;
+    if (timeout != NULL)
+    {
+        struct timespec after;
+        if (clock_gettime(CLOCK_MONOTONIC, &after) != 0)
+            return -1;
+        int64_t elapsed = (int64_t)(after.tv_sec - before.tv_sec) * 1000000
+                         + (after.tv_nsec - before.tv_nsec) / 1000;
+        remaining = elapsed >= remaining ? 0 : remaining - elapsed;
+        timeout->tv_sec = remaining / 1000000;
+        timeout->tv_usec = remaining % 1000000;
+    }
+    errno = saved_errno;
+    if (res < 0)
+        return -1;
+#ifdef NS_ABORT_USE_PIPE
+    if (fds[1].revents != 0)
+#else
+    if (netbios_abort_ctx_is_aborted(ctx))
+#endif
+    {
+        errno = EINTR;
+        return -1;
+    }
+    if (fds[0].revents & POLLNVAL)
+    {
+        errno = EBADF;
+        return -1;
+    }
+    /* Let the subsequent send/recv/getsockopt report EOF or socket errors. */
+    return fds[0].revents != 0 ? 1 : 0;
+#endif
+}
